# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging
build/
dist/
*.egg-info/
.eggs/
wheels/

# Environment and secrets
.env
.env.*
!.env.example

# Tests and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Linters and type checkers
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/

# Logs
logs/
*.log

# Local data: uploaded Excel files, DB dumps
uploads/
media/
*.sqlite3
*.db
*.dump
# Excel files are not committed; keep test fixtures
*.xlsx
*.xls
!tests/fixtures/**/*.xlsx
!tests/fixtures/**/*.xls

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
