# Настройки бэкенда. Скопировать в backend/.env и поправить:
#   cp backend/.env.example backend/.env
# Файл читают и docker compose (env_file), и бэкенд без Docker.
# Сам backend/.env в гит не коммитится.

# Строка подключения к БД. В Docker перекрывается docker-compose.yml.
# Без Docker к Postgres из docker compose — порт 5433:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/csu_schedule
# Для локального запуска без Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./schedule.db

# Откуда фронтенд обращается к API (CORS), через запятую.
# Для APK добавить https://localhost.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_DOCS_ENABLED=false

# Вход в админку. Пустой ADMIN_PASSWORD — вход выключен.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# ЛК продукта — страница /statistic со статистикой для команды (не методиста).
# Пустой PRODUCT_PASSWORD — вход выключен.
PRODUCT_LOGIN=product
PRODUCT_PASSWORD=
# Событий статистики с одного устройства за час; лишние отбрасываются
PRODUCT_EVENTS_LIMIT_PER_HOUR=120
PRODUCT_EVENTS_IP_LIMIT=240

# Обязательный секрет подписи JWT.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=12
# Число попыток входа за 10 минут с IP и для пары IP/логин.
LOGIN_IP_LIMIT=80
LOGIN_PAIR_LIMIT=8

# Число обращений за час с аккаунта Moodle и IP.
FEEDBACK_RATE_LIMIT_PER_HOUR=5
FEEDBACK_IP_RATE_LIMIT_PER_HOUR=40

# Почта для обращений — SMTP Яндекса. Нужен пароль приложения:
# id.yandex.ru → Безопасность → Пароли приложений → «Почта».
# Пустой SMTP_USER — письма пропускаются, обращения сохраняются.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Расписание ИИТ
# Ссылка на приложение в письмах (необязательно)
PUBLIC_APP_URL=

# Напоминание по одному сообщению — не чаще раза в столько часов
REMIND_COOLDOWN_HOURS=6
# Групповые сообщения за столько дней досылаются новичкам и сменившим группу
MESSAGES_LATE_JOIN_DAYS=14

# Push-уведомления (Web Push). Ключи: python -m app.cli generate-vapid
# Пустые — Web Push выключен; FCM настраивается отдельно.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com

# Android FCM: ключ в backend/secrets/firebase-service-account.json (не коммитить).
# Локально: secrets/firebase-service-account.json; в Docker: /app/secrets/firebase-service-account.json.
# Пустое значение выключает FCM.
FCM_CREDENTIALS_FILE=

# Пауза worker'а после пустого прохода (секунды)
WORKER_POLL_SECONDS=2
# Максимум push-доставок за один проход
PUSH_BATCH_SIZE=100
# Число одновременных асинхронных отправок push
PUSH_CONCURRENCY=8
# Максимум попыток push до статуса failed
PUSH_MAX_ATTEMPTS=5

# Вход через Moodle ИИТ
MOODLE_BASE_URL=https://eu.iit.csu.ru
# Обязательный отдельный ключ AES-256-GCM: 32 случайных байта в base64.
# Сгенерировать: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Хранить вне БД и репозитория. Пароль Moodle не сохраняется.
MOODLE_ENCRYPTION_KEY=
# Фиктивный вход для разработки.
MOODLE_MOCK=false
