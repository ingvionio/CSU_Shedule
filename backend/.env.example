# Строка подключения к БД. Postgres — основной вариант.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/csu_schedule
# Для локального запуска без Postgres:
# DATABASE_URL=sqlite+pysqlite:///./schedule.db

# Откуда фронтенд обращается к API (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Вход в админку. Пустой ADMIN_PASSWORD — вход выключен.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
# Секрет подписи JWT — в бою обязательно поменять
JWT_SECRET=change-me
JWT_TTL_HOURS=12

# Почта для обращений — SMTP Яндекса. Нужен пароль приложения:
# id.yandex.ru → Безопасность → Пароли приложений → «Почта».
# Пустой SMTP_USER — письма не уходят, а пишутся в лог.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Расписание ИИТ
# Ссылка на приложение в письмах (необязательно)
PUBLIC_APP_URL=

# Обязательный отдельный ключ AES-256-GCM: 32 случайных байта в base64.
# Сгенерировать: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Хранить вне БД и репозитория. Пароль Moodle не сохраняется.
MOODLE_ENCRYPTION_KEY=
MOODLE_BASE_URL=https://eu.iit.csu.ru
MOODLE_MOCK=false
# Напоминание по одному сообщению — не чаще раза в столько часов
REMIND_COOLDOWN_HOURS=6
# Групповые сообщения за столько дней досылаются новичкам и сменившим группу
MESSAGES_LATE_JOIN_DAYS=14

# Push-уведомления (Web Push). Ключи: python -m app.cli generate-vapid
# Пустые — push выключен, сообщения видны только в приложении.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
