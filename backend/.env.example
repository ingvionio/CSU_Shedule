# Строка подключения к БД. Postgres — основной вариант.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/csu_schedule
# Для локального запуска без Postgres:
# DATABASE_URL=sqlite+pysqlite:///./schedule.db

# Откуда фронтенд обращается к API (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
