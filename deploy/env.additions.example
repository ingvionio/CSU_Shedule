# Новые строки для существующего /home/antigravity/csu_schedule/backend/.env.
# Остальное в .env не трогать: JWT_SECRET и DATABASE_URL остаются прежними.

# --- Web Push (браузер и iPhone) ---
# Сгенерировать на сервере ОДИН раз:
#   cd ~/csu_schedule/backend && ../releases/current/venv/bin/python -m app.cli generate-vapid
# После запуска не менять: все подписки браузеров станут недействительными.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:АДРЕС_АДМИНИСТРАТОРА

# --- Push в Android (FCM) ---
# Ключ сервисного аккаунта Firebase-проекта iit-app; файл не в гите,
# права 600, владелец antigravity.
FCM_CREDENTIALS_FILE=/home/antigravity/csu_schedule/backend/secrets/firebase-service-account.json

# --- Worker (значения по умолчанию, задавать не обязательно) ---
# WORKER_POLL_SECONDS=2
# PUSH_BATCH_SIZE=100
# PUSH_CONCURRENCY=8
# PUSH_MAX_ATTEMPTS=5

# --- Проверить, что уже есть ---
# CORS_ORIGINS должен включать https://localhost (origin Android-приложения),
# например: CORS_ORIGINS=https://iit-app.ru,https://illusoryorb.ru,https://localhost
# MOODLE_ENCRYPTION_KEY на работающем проде НЕ добавлять: сохранённые пароли
# Moodle перестанут расшифровываться, студенты разлогинятся.
