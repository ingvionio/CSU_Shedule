# Скопируйте в .env рядом с docker-compose.prod.yml и заполните пустые секреты.
# Обязательные значения: для каждого отдельный секрет — openssl rand -hex 32
# POSTGRES_PASSWORD должен быть hex: пароль включается в URL подключения.
# Для уже существующей базы — её текущий пароль (POSTGRES_PASSWORD при
# создании тома ни на что не влияет; сменить: ALTER USER postgres PASSWORD '…').
POSTGRES_PASSWORD=
# JWT_SECRET нельзя менять после запуска: студенты разлогинятся; без отдельного
# MOODLE_ENCRYPTION_KEY сохранённые пароли Moodle перестанут расшифровываться.
# На работающем проде iit-app.ru — перенести текущий секрет без изменений.
JWT_SECRET=
# Пароль методиста; логин по умолчанию admin.
ADMIN_PASSWORD=
ADMIN_LOGIN=admin

# Отдельный ключ Moodle: openssl rand -hex 32. Пусто — выводится из JWT_SECRET.
# После запуска нельзя менять ключ или переходить с пустого на отдельный:
# сохранённые пароли Moodle не расшифруются.
# На работающем проде iit-app.ru оставить пустым (задавать только на новой установке).
MOODLE_ENCRYPTION_KEY=
# Адрес Moodle института.
MOODLE_BASE_URL=https://eu.iit.csu.ru

# Порт API на 127.0.0.1; при изменении исправьте proxy_pass nginx.
BACKEND_PORT=8000
# Разрешённые origin сайта и Android WebView Capacitor.
CORS_ORIGINS=https://iit-app.ru,https://localhost
# Адрес приложения для ссылок в письмах.
PUBLIC_APP_URL=https://iit-app.ru

# SMTP Яндекса: ящик и пароль приложения; пустой SMTP_USER отключает отправку.
SMTP_USER=
SMTP_PASSWORD=
# Путь ВНУТРИ контейнера к ключу Firebase, например /app/secrets/fcm.json.
# Сам файл хранится в backend/secrets; пустое значение отключает FCM.
FCM_CREDENTIALS_FILE=

# Web Push: выполните python -m app.cli generate-vapid в окружении бэкенда.
# Сохраните оба ключа; VAPID нельзя менять после запуска — пропадут подписки.
# Пустые ключи отключают Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт администратора для push-сервисов (mailto:... или https://...).
VAPID_SUBJECT=mailto:admin@example.com

# Срок действия студенческого JWT в часах (60 дней).
STUDENT_JWT_TTL_HOURS=1440
# Минимальный интервал напоминаний по сообщению в часах.
REMIND_COOLDOWN_HOURS=6
# Интервал опроса пустой очереди worker в секундах; больше нуля.
WORKER_POLL_SECONDS=2
# Размер пачки push, параллельность отправок и максимум попыток; больше нуля.
PUSH_BATCH_SIZE=100
PUSH_CONCURRENCY=8
PUSH_MAX_ATTEMPTS=5

# DATABASE_URL compose собирает сам из POSTGRES_PASSWORD, адреса postgres
# и базы csu_schedule; отдельно задавать не нужно.
# FORWARDED_ALLOW_IPS="*" закреплён в compose: nginx приходит из docker-сети.
# Это допустимо только при публикации API на 127.0.0.1.
